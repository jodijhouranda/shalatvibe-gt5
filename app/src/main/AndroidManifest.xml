<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notifikasi (Android 13+) agar diteruskan ke Huawei Health / Watch GT 5 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Getar lokal di HP & channel notifikasi -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Alarm tepat waktu (Android 12+) dan otomatis untuk sideload (Android 13+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Izin meminta pengecualian optimasi baterai langsung 1 ketuk -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Menjaga jadwal tetap aktif setelah HP restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wake lock singkat saat receiver memicu notifikasi -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lokasi opsional untuk deteksi koordinat shalat otomatis -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_mosque"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_mosque"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShalatVibeGT5">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alarm.PrayerAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
